<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_notes" model="ir.ui.view">
        <field name="name">res.company.form.notes</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="before">
                <page string="Notas" name="notes">
                    <field name="comment" nolabel="1" placeholder="Notas internas..."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
